{
  "compilerOptions": {
    "strictNullChecks": true,
    "declaration": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "allowJs": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "./lib",
    "baseUrl": ".",
    "rootDir": "./src",
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "typings/*",
    "src/**/*"
  ]
}